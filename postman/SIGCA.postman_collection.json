{
  "info": {
    "name": "SIGCA — API académica",
    "description": "Colección para pruebas controladas en sigca_dev o sigca_test. Configure baseUrl, token e identificadores en un entorno privado de Postman. No exporte valores de credenciales ni ejecute escrituras sobre datos reales de producción. Los cuerpos son ejemplos ficticios; sustituya los identificadores y fechas antes de enviarlos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
