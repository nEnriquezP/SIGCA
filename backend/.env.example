# Copiar este archivo como backend/.env y completar la URI privada de MongoDB Atlas.
# El nombre de la base se indica en la URI: sigca_dev, sigca_test o sigca_prod.
MONGO_URI=
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=
# Prefijos: sigca/dev, sigca/test o sigca/prod según la base conectada.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=sigca/dev
# Correo transaccional: usar una dirección de un dominio verificado en Resend.
# El nombre visible del remitente se toma del nombre público del centro en SIGCA.
RESEND_API_KEY=
EMAIL_FROM=
APP_PUBLIC_URL=http://localhost:5173
# Una misma clave larga para Render y GitHub Actions (solo en gestores de secretos).
SIGCA_CRON_SECRET=
